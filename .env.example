# Copy to .env and fill in.

# Password of the first administrator (at least 10 characters). Only used while no user exists.
ATB_ADMIN_PASSWORD=

# Optional: your own master key (`docker compose run --rm bridge atb generate-key`).
# When empty it is generated once in the data volume. Back it up: without it stored SSH keys are unreadable.
ATB_MASTER_KEY=

# HTTPS profile: docker compose --profile https up -d
ATB_DOMAIN=

# Extra Host names accepted by the MCP endpoint, comma separated, e.g. 192.168.1.10:*
ATB_EXTRA_HOSTS=

# Browser-based MCP clients send an Origin header; list the ones you allow, comma separated.
ATB_ALLOWED_ORIGINS=

# Address and port published on the Docker host. Keep 127.0.0.1 unless a firewall or VPN protects it.
ATB_BIND=127.0.0.1
ATB_PUBLISH_PORT=8750

# PostgreSQL instead of SQLite: docker compose --profile postgres up -d
# POSTGRES_PASSWORD=change-me
# ATB_DATABASE_URL=postgresql+asyncpg://atb:change-me@postgres:5432/atb
